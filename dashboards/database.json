{
  "title": "Database",
  "uid": "database-dashboard",
  "schemaVersion": 39,
  "timezone": "browser",
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "30s",
  "panels": [
    {
      "id": 1, "title": "Active Connections", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [{ "expr": "sum(pg_stat_database_numbackends{datname=\"appdb\"})", "legendFormat": "connections" }]
    },
    {
      "id": 2, "title": "Query Rate (commits + rollbacks / sec)", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "rate(pg_stat_database_xact_commit{datname=\"appdb\"}[5m])", "legendFormat": "commits/sec" },
        { "expr": "rate(pg_stat_database_xact_rollback{datname=\"appdb\"}[5m])", "legendFormat": "rollbacks/sec" }
      ]
    },
    {
      "id": 3, "title": "Replication Lag (seconds)", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [{ "expr": "pg_replication_lag", "legendFormat": "lag" }],
      "description": "Only relevant with read replicas. Empty on single-instance setups."
    },
    {
      "id": 4, "title": "Database Disk Usage", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [{ "expr": "pg_database_size_bytes{datname=\"appdb\"}", "legendFormat": "size (bytes)" }]
    }
  ]
}
